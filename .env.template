# RetentionAI Local Development Configuration Template
# Copy this file to .env for local Docker Compose or python execution

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# API & Security
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8000
RATE_LIMIT_PREDICT_PER_MINUTE=60
ADMIN_KEY=dev-admin-secret-key-123

# Model Execution & Data Flags
# Set ALLOW_SYNTHETIC_DATA=1 only for unit tests or synthetic smoke tests
ALLOW_SYNTHETIC_DATA=0
FORCE_RETRAIN=0

# Frontend Base URL (for Vite build)
VITE_API_BASE_URL=http://localhost:8000
