# RetentionAI Production Configuration Template (Azure / Cloud)
# Secrets should be provisioned into Azure Key Vault / Container App environment secrets

# Azure Cache for Redis (SSL Port 6380)
# Example: rediss://:PRIMARY_KEY@retentionai-redis.redis.cache.windows.net:6380/0
REDIS_URL=rediss://:YOUR_AZURE_REDIS_ACCESS_KEY@retentionai-redis.redis.cache.windows.net:6380/0

# Production CORS Allowed Origins (Comma-separated)
ALLOWED_ORIGINS=https://retentionai.azurecontainerapps.io,https://retentionai.com

# Rate Limiting & Protection
RATE_LIMIT_PREDICT_PER_MINUTE=30
ADMIN_KEY=REPLACE_WITH_STRONG_RANDOM_UUID_OR_HEX

# Data & Serving Flags (0 for verified real Kaggle snapshot artifacts)
ALLOW_SYNTHETIC_DATA=0
FORCE_RETRAIN=0

# Frontend Base URL
VITE_API_BASE_URL=/api
